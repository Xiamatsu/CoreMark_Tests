    "version": "0.2.0",
    "configurations": [
        {
            "cwd": "${workspaceRoot}",
            "executable": "${ProjectName}.elf",
            "name": "pyocd",
            "request": "launch",
            "type": "cortex-debug",
            "targetId": "STM32F103x6",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "servertype": "pyocd",
