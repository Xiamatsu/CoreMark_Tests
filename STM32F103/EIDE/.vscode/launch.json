                "interface/cmsis-dap.cfg",
                "target/stm32c011.cfg"
            ],
            "toolchainPrefix": "arm-none-eabi",
            "svdFile": "../System/STM32F103xx.svd"
        },
        {
            "cwd": "${workspaceRoot}",
            "type": "cortex-debug",
            "request": "launch",
            "name": "jlink",
            "servertype": "jlink",
            "interface": "swd",
            "executable": "${ProjectName}.elf",
            "runToEntryPoint": "main",
            "device": "STM32F103C6",
